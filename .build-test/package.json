{
  "name": "threejs-remotion-video",
  "version": "1.0.0",
  "description": "Production-ready 3D video pipeline: Three.js + Remotion + Blender + Audio + Video Editing",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/Root.tsx",
    "build": "remotion render src/Root.tsx",
    "build:video": "remotion render src/Root.tsx main-video out/video.mp4 --concurrency=4",
    "build:still": "remotion still src/Root.tsx out/frame.png",
    "preview": "remotion preview src/Root.tsx",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "blender:export": "node scripts/blender-export.js",
    "blender:bake": "node scripts/blender-bake.js",
    "blender:assets": "node scripts/blender-generate.js",
    "blender:headless": "blender -b -P blender/export_gltf.py",
    "lambda:deploy": "remotion lambda functions deploy --region=us-east-1",
    "lambda:render": "remotion lambda render src/Root.tsx --function-name=remotion-render",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "automation:prompt": "node scripts/automation-build.cjs prompt",
    "automation:spec": "node scripts/automation-build.cjs spec",
    "automation:dev": "node scripts/automation-build.cjs dev",
    "automation:render": "node scripts/automation-build.cjs render",
    "automation:generate-spec": "node scripts/automation-build.cjs generate-spec",
    "automation:compositions": "node scripts/automation-build.cjs compositions",
    "automation:clean": "node scripts/automation-build.cjs clean",
    "automation:build": "tsc --project tsconfig.automation.json && node scripts/automation-build.cjs",
    "viral:prompt": "node scripts/viral-build.cjs prompt",
    "viral:spec": "node scripts/viral-build.cjs spec",
    "viral:generate-spec": "node scripts/viral-build.cjs generate-spec",
    "viral:dev": "node scripts/viral-build.cjs dev",
    "viral:platforms": "node scripts/viral-build.cjs platforms",
    "viral:validate": "node scripts/viral-build.cjs validate",
    "viral:clean": "node scripts/viral-build.cjs clean",
    "viral:build": "tsc --project tsconfig.automation.json && node scripts/viral-build.cjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.0",
    "@react-three/postprocessing": "^2.16.0",
    "@react-three/rapier": "^1.5.0",
    "@remotion/bundler": "^4.0.541",
    "@remotion/cli": "^4.0.541",
    "@remotion/eslint-config": "^4.0.541",
    "@remotion/lambda": "^4.0.541",
    "@remotion/media-parser": "^4.0.541",
    "@remotion/player": "^4.0.541",
    "@remotion/renderer": "^4.0.541",
    "@remotion/shapes": "^4.0.541",
    "@remotion/tailwind": "^4.0.541",
    "@remotion/three": "^4.0.541",
    "@remotion/zod-types": "^4.0.541",
    "@tonejs/midi": "^2.0.28",
    "canvas": "^3.2.3",
    "commander": "^12.1.0",
    "framer-motion": "^11.11.0",
    "jotai": "^2.10.0",
    "postprocessing": "^6.36.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^4.5.0",
    "react-use-gesture": "^9.1.3",
    "three": "^0.178.0",
    "three-stdlib": "^2.34.0",
    "tone": "^15.0.4",
    "zod": "4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config": "^4.0.541",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.178.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "happy-dom": "^15.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "packageManager": "pnpm@9.12.0"
}
