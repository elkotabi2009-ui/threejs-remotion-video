{
  "inputBlend": "assets/source/scene.blend",
  "outputDir": "public/assets/models",
  "format": "GLTF",
  "exportSettings": {
    "selectedOnly": false,
    "applyModifiers": true,
    "exportAnimations": true,
    "exportShapeKeys": true,
    "exportSkins": true,
    "exportNlaStrips": true,
    "exportCurrentFrame": false,
    "exportFrameRange": false,
    "exportFrameStep": 1,
    "exportForceSampling": true,
    "exportDefBones": true,
    "exportOptimizeAnimationSize": true,
    "exportAnimationMode": "ACTIONS",
    "textureDirectory": "textures",
    "copyTextures": true,
    "exportTangents": true,
    "exportMeshData": "MESH",
    "exportAttributes": ["POSITION", "NORMAL", "TANGENT", "TEXCOORD_0", "COLOR_0", "JOINTS_0", "WEIGHTS_0"],
    "exportImageFormat": "AUTO",
    "exportImageQuality": 85,
    "exportMaterial": "EXPORT",
    "exportColors": true,
    "exportCameras": false,
    "exportLights": false,
    "exportExtras": true,
    "exportYup": true,
    "exportRelativePaths": true
  }
}