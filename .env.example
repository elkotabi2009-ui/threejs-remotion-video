# Three.js + Remotion Video Pipeline Environment Variables

# Remotion Configuration
REMOTION_SERVE_URL=http://localhost:3000
REMOTION_BUNDLE_OVERRIDE=false

# Rendering
REMOTION_CONCURRENCY=4
REMOTION_CHUNK_SIZE=25
REMOTION_LOG_LEVEL=verbose
REMOTION_OVERWRITE_OUTPUT=true

# Lambda Cloud Rendering (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
REMOTION_LAMBDA_FUNCTION_NAME=remotion-render
REMOTION_LAMBDA_MEMORY=3008
REMOTION_LAMBDA_TIMEOUT=900
REMOTION_LAMBDA_CONCURRENCY=50
REMOTION_LAMBDA_BUCKET=your-bucket-name
REMOTION_LAMBDA_PREFIX=renders/

# Blender Configuration
BLENDER_PATH=blender
BLENDER_VERSION=4.0
BLENDER_HEADLESS=true

# Asset Paths
ASSETS_SOURCE_DIR=assets/source
ASSETS_OUTPUT_DIR=public/assets
MODELS_DIR=public/assets/models
TEXTURES_DIR=public/assets/textures
AUDIO_DIR=public/assets/audio
FONTS_DIR=public/assets/fonts

# Video Export Settings
VIDEO_CODEC=h264
VIDEO_CRF=18
VIDEO_PRESET=medium
VIDEO_PIXEL_FORMAT=yuv420p
AUDIO_CODEC=aac
AUDIO_BITRATE=192k

# Audio
AUDIO_SAMPLE_RATE=48000
AUDIO_BUFFER_SIZE=4096
AUDIO_ENABLE_OPUS=true

# Development
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# Performance
MAX_MEMORY_MB=4096
ENABLE_GPU_ACCELERATION=true
THREE_JS_PERFORMANCE_MONITOR=false

# Feature Flags
ENABLE_TIMELINE_EDITOR=true
ENABLE_AUDIO_VISUALIZER=true
ENABLE_3D_EDITOR=true
ENABLE_LAMBDA_RENDER=false
ENABLE_STORYBOOK=false